# Copy to .env for local use. Store real values in your deployment's secret settings.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/terra-nova
MONGODB_DB=terra-nova
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@terranova.earth
ADMIN_PASSWORD=replace-with-a-unique-password
CERTIFICATE_SIGNING_SECRET=replace-with-a-separate-random-secret
APP_URL=http://localhost:3000

# Stripe hosted checkout and webhook verification.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google OAuth. Register this exact callback URL in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI alternative; takes precedence when both keys are configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional only when browser clients call the API from a different origin.
CORS_ORIGIN=